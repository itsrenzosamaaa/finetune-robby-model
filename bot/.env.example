# ── Discord ──────────────────────────────────────────────────────────────────
# Get this from https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=your-discord-bot-token-here

# ── Model ────────────────────────────────────────────────────────────────────
# Path to your downloaded fine-tuned model (merged_model folder from RunPod)
MODEL_PATH=./output/merged_model

# Set to "true" if you want to load only the LoRA adapter (smaller download)
# and stream the base model from HuggingFace. Requires BASE_MODEL to be set.
USE_LORA_ONLY=false
BASE_MODEL=unsloth/Qwen2.5-3B-Instruct

# ── Generation settings ───────────────────────────────────────────────────────
MAX_NEW_TOKENS=200
TEMPERATURE=0.8
TOP_P=0.9

# ── Bot behavior ──────────────────────────────────────────────────────────────
COMMAND_PREFIX=!

# Comma-separated channel IDs the bot is allowed to respond in.
# Leave empty to allow all channels.
# Example: ALLOWED_CHANNEL_IDS=123456789,987654321
ALLOWED_CHANNEL_IDS=
